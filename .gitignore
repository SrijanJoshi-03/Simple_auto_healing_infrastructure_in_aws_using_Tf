# Local Terraform working directories and caches
**/.terraform/*

# State files (contain resource attributes / sensitive data) - kept out of git
# because this repo uses an S3 backend (see backend.tf). If you switch to
# local state, .gitignore already covers it below.
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*

# Files that hold real/secret variable values.
# NOTE: terraform.tfvars in THIS repo only contains an empty stub (all
# variables have safe defaults in variable.tf) so it's safe to commit, but
# any *.auto.tfvars or override files an operator creates locally should
# stay untracked.
*.auto.tfvars
*.auto.tfvars.json
secrets.tfvars

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# OS / editor junk
.DS_Store
.idea/
.vscode/
